#include <bits/stdc++.h>
using namespace std;
using ll = long long;
int main(){
    int t;cin>>t;
    while(t--){
        ll n,m,a,b;cin>>n>>m>>a>>b;
        if(((n%a!=0 || a%n!=0)|| a==1) && ((m%b!=0 || b%m!=0)|| b==1)){
            ll nn = a*(n/a);
            ll nm = b*(m/b);
            if(nn%nm==0 && nm%nn==0){
                cout<<"YES"<<'\n';
            }else{
                cout<<"NO"<<'\n';
            }
        }else{
            cout<<"NO"<<'\n';
        }
    }
}
